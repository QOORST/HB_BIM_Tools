<Window x:Class="YD_RevitTools.LicenseManager.Commands.MEP.PipeSleeveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="管線套管工具" Height="760" Width="1100"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        MinHeight="400"
        MinWidth="560"
        FontFamily="Microsoft JhengHei UI" FontSize="13" Background="White"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        ShowInTaskbar="True">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <StackPanel>
                            <ContentPresenter ContentSource="Header" TextElement.FontWeight="SemiBold"/>
                            <ContentPresenter ContentSource="Content"/>
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#BCC4C8"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#008080"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <CheckBox x:Name="chkAutoSize" Visibility="Collapsed" IsChecked="True"/>
        <CheckBox x:Name="chkMeasureDistance" Visibility="Collapsed" IsChecked="True"/>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="建立套管" FontSize="16" FontWeight="SemiBold"/>
            <Border Height="1" Background="#777" Margin="0,14,0,0"/>
        </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid x:Name="bodyLayout" SizeChanged="BodyLayout_SizeChanged">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="settingsColumn" Width="3*"/>
                        <ColumnDefinition x:Name="separatorColumn" Width="25"/>
                        <ColumnDefinition x:Name="referenceColumn" Width="2*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border x:Name="bodySeparator" Grid.Column="1" Grid.RowSpan="3" Width="1" Background="#D8DEE2"/>
                    <StackPanel x:Name="settingsPanel" Grid.Row="0">
                    <GroupBox Header="新增套管約束樓層" Margin="0,0,0,14">
                        <ComboBox x:Name="cmbCreationLevel" Margin="10" MinHeight="28"
                                  DisplayMemberPath="Name" SelectedValuePath="Key"/>
                    </GroupBox>
                    <GroupBox Header="管篩選模式" Margin="0,0,0,14">
                        <StackPanel Margin="10">
                            <RadioButton x:Name="rbSelectedPipes" Content="使用目前已選取管線" IsChecked="True" Margin="0,0,0,8"/>
                            <RadioButton x:Name="rbManualPipes" Content="重新手動選取管線" IsEnabled="False"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="指定套管類型" Margin="0,0,0,14">
                        <StackPanel Margin="10">
                            <CheckBox x:Name="chkUseDiameterMap" Content="依管徑自動套用大一級套管類型"
                                      IsChecked="True" Margin="0,0,0,12"/>
                            <TextBlock Text="牆套管預設類型" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <ComboBox x:Name="cmbWallSleeveFamily" Height="28" Margin="0,0,0,10"/>
                            <TextBlock Text="樓板/樑套管預設類型" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <ComboBox x:Name="cmbFloorSleeveFamily" Height="28"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="套管尺寸計算方式" Margin="0,0,0,14">
                        <StackPanel Margin="10">
                            <ComboBox x:Name="cmbSizeRule" Height="28" SelectedIndex="0" Margin="0,0,0,10">
                                <ComboBoxItem Content="管徑放大一級"/>
                            </ComboBox>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="間隙距離" Width="80" VerticalAlignment="Center"/>
                                <TextBox x:Name="txtClearance" Width="86" Height="24" Text="50"/>
                                <TextBlock Text="mm" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="管道穿牆位置" Margin="0,0,0,14">
                        <StackPanel Margin="10">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <CheckBox x:Name="chkIncludeCurrentModel" Content="當前模型"
                                          IsChecked="True" Margin="0,0,24,0"/>
                                <CheckBox x:Name="chkIncludeLinks" Content="連結模型"
                                          IsChecked="True"/>
                            </StackPanel>
                            <CheckBox x:Name="chkExcludeAdditionElements" Content="排除牆/樓板增築邊界"
                                      IsChecked="True"/>
                        </StackPanel>
                    </GroupBox>

                    <CheckBox x:Name="chkLimitToActiveView" Content="限制於目前視圖" IsChecked="True" Margin="10,0,0,14"/>
                    <GroupBox Header="編號與更新" Margin="0,0,0,14">
                        <StackPanel Margin="10" Orientation="Horizontal">
                            <CheckBox x:Name="chkAutoNumber" Content="自動編號套管"
                                      IsChecked="True" Margin="0,0,24,0"/>
                            <CheckBox x:Name="chkUpdateExisting" Content="更新現有套管"
                                      IsChecked="False"/>
                        </StackPanel>
                    </GroupBox>

                    </StackPanel>
                    <Border x:Name="referencePanel" Grid.Row="0" Grid.Column="2" Grid.RowSpan="3" Padding="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="穿梁複核參考" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left">
                                <Canvas Width="430" Height="154">
                                    <Rectangle Canvas.Left="20" Canvas.Top="50" Width="390" Height="46" Fill="#D9DEE3" Stroke="#89919A" StrokeThickness="1"/>
                                    <Rectangle Canvas.Left="20" Canvas.Top="46" Width="390" Height="4" Fill="#8A929B"/>
                                    <Rectangle Canvas.Left="20" Canvas.Top="96" Width="390" Height="4" Fill="#8A929B"/>
                                    <Rectangle Canvas.Left="20" Canvas.Top="18" Width="48" Height="112" Fill="#C6CCD2" Stroke="#7C858E" StrokeThickness="1"/>
                                    <Rectangle Canvas.Left="362" Canvas.Top="18" Width="48" Height="112" Fill="#C6CCD2" Stroke="#7C858E" StrokeThickness="1"/>
                                    <Line X1="68" Y1="133" X2="128" Y2="133" Stroke="#D9534F" StrokeThickness="2" StrokeDashArray="4 3"/>
                                    <Line X1="302" Y1="133" X2="362" Y2="133" Stroke="#D9534F" StrokeThickness="2" StrokeDashArray="4 3"/>
                                    <TextBlock Canvas.Left="83" Canvas.Top="136" Text="2H 禁開區" Foreground="#D9534F" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Canvas.Left="304" Canvas.Top="136" Text="2H 禁開區" Foreground="#D9534F" FontSize="12" FontWeight="SemiBold"/>
                                    <Line X1="152" Y1="70" X2="182" Y2="70" Stroke="#2B2B2B" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Ellipse Canvas.Left="168" Canvas.Top="58" Width="24" Height="24" Fill="#FFFFFF" Stroke="#E67E22" StrokeThickness="4"/>
                                    <TextBlock Canvas.Left="142" Canvas.Top="20" Text="提醒" Foreground="#B45F06" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Canvas.Left="124" Canvas.Top="36" Text="孔徑 ≥100mm" Foreground="#555" FontSize="11"/>
                                    <Line X1="225" Y1="70" X2="255" Y2="70" Stroke="#2B2B2B" StrokeThickness="10" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Ellipse Canvas.Left="239" Canvas.Top="54" Width="32" Height="32" Fill="#FFFFFF" Stroke="#D9534F" StrokeThickness="4"/>
                                    <TextBlock Canvas.Left="220" Canvas.Top="20" Text="需結構確認" Foreground="#B00020" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Canvas.Left="214" Canvas.Top="36" Text="≥200mm 或 &gt; H/3" Foreground="#555" FontSize="11"/>
                                    <Line X1="194" Y1="112" X2="244" Y2="112" Stroke="#666" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Ellipse Canvas.Left="190" Canvas.Top="104" Width="16" Height="16" Fill="#FFFFFF" Stroke="#D9534F" StrokeThickness="3"/>
                                    <Ellipse Canvas.Left="236" Canvas.Top="104" Width="16" Height="16" Fill="#FFFFFF" Stroke="#D9534F" StrokeThickness="3"/>
                                    <TextBlock Canvas.Left="181" Canvas.Top="124" Text="孔距 &lt; 3D 或 300mm" Foreground="#B00020" FontSize="11"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="紅色：梁端/柱邊 2H、孔徑、梁深比例或孔距不符，仍生成但標示為需複核。"
                                       TextWrapping="Wrap" Margin="0,8,0,0" Foreground="#555" FontSize="12"/>
                            <GroupBox Header="執行狀態" Margin="0,24,0,0">
                                <StackPanel Margin="0,10,0,0">
                                    <TextBlock x:Name="txtPreview" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,10"/>
                                    <ProgressBar x:Name="progressExecution" Height="8" Minimum="0" Maximum="100" Value="0"/>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </Border>
                    <StackPanel x:Name="advancedPanel" Grid.Row="1">
                    <Expander Header="進階尺寸對應" IsExpanded="False" Margin="0,0,0,14">
                        <StackPanel>
                        <WrapPanel Margin="0,8,0,0">
                            <TextBlock Text="管徑 DN" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="txtNewNominalDn" Text="15" Width="90" VerticalContentAlignment="Center"/>
                            <Button Content="＋" Width="36" Height="30" Margin="8,0,0,0" ToolTip="新增標稱管徑" Click="AddNominalSize_Click"/>
                            <Button Content="−" Width="36" Height="30" Margin="8,0,0,0" ToolTip="移除選取的管徑對應" Click="RemoveNominalSize_Click"/>
                        </WrapPanel>
                        <DataGrid x:Name="gridSleeveSizes"
                                  ItemsSource="{Binding SleeveSizeRows}"
                                  AutoGenerateColumns="False"
                                  HeadersVisibility="Column"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  RowHeight="28"
                                  MaxHeight="240"
                                  Margin="0,8,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="管道標稱直徑" Binding="{Binding NominalName}" Width="140" IsReadOnly="True"/>
                                <DataGridTemplateColumn Header="套管類型" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.SleeveSymbolChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      DisplayMemberPath="DisplayName"
                                                      SelectedValuePath="IdValue"
                                                      SelectedValue="{Binding SymbolIdValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        </StackPanel>
                    </Expander>

                    </StackPanel>
                </Grid>
            </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="btnExecute" Grid.Column="0" Content="開始執行" Height="38"
                    Click="BtnExecute_Click" IsEnabled="True"
                    Background="#008080" Foreground="White" BorderBrush="#008080"
                    FontSize="15" FontWeight="SemiBold"/>
            <Button x:Name="btnSaveDefaults" Grid.Column="1" Content="儲存預設" Height="38" Margin="12,0,0,0"
                    Click="BtnSaveDefaults_Click"/>
            <Button x:Name="btnCancel" Grid.Column="2" Content="取消" Height="38" Margin="12,0,0,0"
                    Click="BtnCancel_Click"/>
        </Grid>
    </Grid>
</Window>




