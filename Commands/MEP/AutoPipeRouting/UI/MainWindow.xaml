<Window x:Class="YD_RevitTools.LicenseManager.Commands.MEP.AutoPipeRouting.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MEP 自動配管設定"
        Width="520"
        Height="430"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F4F6F8"
        Topmost="True">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="#0A3A66" CornerRadius="8" Padding="12" Grid.Row="0">
            <StackPanel>
                <TextBlock Text="自動配管" Foreground="White" FontSize="18" FontWeight="Bold"/>
                <TextBlock Text="先選設備或支管，再選水平幹管，自動建立洩水支管與幹管接頭" Foreground="#DCEBFA" FontSize="12" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Margin="0,12,0,0" Background="White" BorderBrush="#D6DEE8" BorderThickness="1" CornerRadius="8" Padding="12">
            <StackPanel>
                <TextBlock Text="配管規則" FontWeight="Bold" Foreground="#1F2937"/>
                <Border Margin="0,6,0,10" Background="#EEF6FF" BorderBrush="#C7DBF2" BorderThickness="1" CornerRadius="4" Padding="10,8">
                    <TextBlock Text="新管沿用幹管系統與管類型，管徑優先採設備接頭尺寸；水平支管依設定坡度洩水。"
                               TextWrapping="Wrap"
                               Foreground="#1F4E79"/>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="38"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="接入前保留長度" VerticalAlignment="Center" Foreground="#374151"/>
                    <TextBox Name="txtDistancePipe" Grid.Column="1" Text="200" Height="30" Padding="8,3"/>
                    <TextBlock Text="mm" Grid.Column="2" VerticalAlignment="Center" Foreground="#6B7280"/>
                </Grid>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="洩水坡度" VerticalAlignment="Center" Foreground="#374151"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBox Name="txtSlope" Text="100" Width="110" Height="30" Padding="8,3"/>
                        <TextBlock x:Name="SlopeHint" Text="  1/100 = 1%" VerticalAlignment="Center" Foreground="#6B7280"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="2" Margin="4,12,4,0" TextWrapping="Wrap" Foreground="#4B5563" FontSize="12"
                   Text="流程：先複選設備或支管，再選水平幹管。保留長度為接入幹管前的管段長度；坡度輸入分母 N（1/N），幹管接入點為低點。"/>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="90"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" Content="開始選取" Height="34" Background="#0A3A66" Foreground="White" FontWeight="Bold" Click="Ok_Click"/>
            <Button Grid.Column="3" Content="取消" Height="34" Click="Cancel_Click"/>
        </Grid>
    </Grid>
</Window>
