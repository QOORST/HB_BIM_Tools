<Window x:Class="YD_RevitTools.LicenseManager.Commands.AR.Finishings.RoomFinish.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="房間裝修管理" Height="760" Width="1240" WindowStartupLocation="CenterOwner" MinHeight="700" MinWidth="1100">
    <Window.Resources>
        <SolidColorBrush x:Key="BgApp" Color="#F4F7FB"/>
        <SolidColorBrush x:Key="BgCard" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BorderSoft" Color="#D6DEE8"/>
        <SolidColorBrush x:Key="PrimaryBlue" Color="#03233D"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#0F4C81"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#5D6B7A"/>
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BgCard}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style x:Key="SectionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinWidth" Value="74"/>
            <Setter Property="Padding" Value="10,2"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#C8D3DF"/>
            <Setter Property="Foreground" Value="#1F2D3D"/>
        </Style>
    </Window.Resources>
    <Grid Background="{StaticResource BgApp}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#03233D" Padding="16,10">
            <TextBlock Text="房間裝修管理" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
        </Border>

        <TabControl x:Name="tabMain" Grid.Row="1" Margin="12">
            <TabItem Header="設定">
                <Border Style="{StaticResource CardBorderStyle}" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="選擇牆面類型" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <ComboBox x:Name="cmbWalls" Grid.Row="1" Grid.Column="0" Height="34" DisplayMemberPath="Name" SelectedValuePath="Id"/>

                        <TextBlock Grid.Row="0" Grid.Column="2" Text="牆面高度 (mm)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBox x:Name="txtWallHeight" Grid.Row="1" Grid.Column="2" Height="34" Text="3000"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="選擇樓板類型" FontWeight="SemiBold" Margin="0,16,0,6"/>
                        <ComboBox x:Name="cmbFloors" Grid.Row="3" Grid.Column="0" Height="34" DisplayMemberPath="Name" SelectedValuePath="Id"/>

                        <TextBlock Grid.Row="2" Grid.Column="2" Text="邊界選項" FontWeight="SemiBold" Margin="0,16,0,6"/>
                        <ComboBox x:Name="cmbBoundary" Grid.Row="3" Grid.Column="2" Height="34">
                            <ComboBoxItem Content="內側完成面" Tag="InnerFinish"/>
                            <ComboBoxItem Content="中心線" Tag="Centerline"/>
                            <ComboBoxItem Content="外側完成面" Tag="OuterFinish"/>
                        </ComboBox>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="選擇天花類型" FontWeight="SemiBold" Margin="0,16,0,6"/>
                        <ComboBox x:Name="cmbCeilings" Grid.Row="5" Grid.Column="0" Height="34" DisplayMemberPath="Name" SelectedValuePath="Id"/>

                        <TextBlock Grid.Row="4" Grid.Column="2" Text="天花高度 (mm)" FontWeight="SemiBold" Margin="0,16,0,6"/>
                        <TextBox x:Name="txtCeilingHeight" Grid.Row="5" Grid.Column="2" Height="34" Text="2700"/>

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="踢腳板類型" FontWeight="SemiBold" Margin="0,16,0,6"/>
                        <ComboBox x:Name="cmbSkirtings" Grid.Row="7" Grid.Column="0" Height="34" VerticalAlignment="Top" DisplayMemberPath="Name" SelectedValuePath="Id"/>

                        <StackPanel Grid.Row="7" Grid.Column="2" VerticalAlignment="Top">
                            <TextBlock Text="踢腳板高度 (mm)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBox x:Name="txtSkirtingHeight" Height="34" Text="100"/>
                        </StackPanel>

                        <Border Grid.Row="8" Grid.ColumnSpan="3" Margin="0,18,0,0" Padding="14" Background="#F4F8FD" BorderBrush="#D7E3F1" BorderThickness="1" CornerRadius="6" VerticalAlignment="Bottom">
                            <StackPanel>
                                <TextBlock Text="操作說明：" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBlock Text="1. 選擇牆、地板、天花與踢腳板類型（可留空）"/>
                                <TextBlock Text="2. 設定牆高、天花高度與邊界模式"/>
                                <TextBlock Text="3. 點擊『選擇房間』進入房間管理並產生裝修面"/>
                                <TextBlock Text="4. 同步資訊：會回寫房間共用參數（牆面塗層、樓板塗層、天花板高度）"/>
                            </StackPanel>
                        </Border>

                        <Button x:Name="btnSelectRooms" Grid.Row="9" Grid.ColumnSpan="3" Height="42" Margin="0,18,0,0" Content="選擇房間" Background="{StaticResource PrimaryBlue}" Foreground="White" FontWeight="SemiBold"/>
                    </Grid>
                </Border>
            </TabItem>

            <TabItem Header="房間管理">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ─── 工具列 ─── -->
                    <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="12,10" Margin="0,0,0,6">
                        <Grid>
                            <Grid.Resources>
                                <Style x:Key="CompactToolbarButton" TargetType="Button" BasedOn="{StaticResource SectionButtonStyle}">
                                    <Setter Property="Height" Value="28"/>
                                </Style>
                            </Grid.Resources>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#EFF5FC" BorderBrush="#D7E3F1" BorderThickness="1" CornerRadius="4" Padding="8,5" Margin="0,0,0,8">
                                <TextBlock Text="建議順序：1 同步與選房 → 2 修補邊界 → 3 調整表格參數 → 4 產出或套用更新"
                                           Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                            </Border>

                            <WrapPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" ItemHeight="34">
                                <Border Background="#F8FBFF" BorderBrush="#D6E2F0" BorderThickness="1" CornerRadius="5" Margin="0,0,8,0" Padding="8,5">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="① 資料同步" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#284A6C" Margin="0,0,8,0"/>
                                        <Button x:Name="btnPickRooms" Content="模型選房" Width="84" Style="{StaticResource CompactToolbarButton}"/>
                                        <Button x:Name="btnFocusRooms" Content="回查模型" Width="84" Style="{StaticResource CompactToolbarButton}"/>
                                        <Button x:Name="btnImportExport" Content="匯入/匯出" Width="86" Style="{StaticResource CompactToolbarButton}"/>
                                        <Button x:Name="btnLoadCurrentStatus" Content="同步模型" Width="82" Style="{StaticResource CompactToolbarButton}" Margin="0,0,2,0"/>
                                        <Button x:Name="btnCheckModelDiff" Content="檢查差異" Width="82" Style="{StaticResource CompactToolbarButton}" Margin="0,0,2,0"
                                                ToolTip="比對房間設定與模型粉刷面 Type、生成狀態及實際裝修牆高；報表可自動建立 AR_Check 3D 驗算視圖。"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#F8FBFF" BorderBrush="#D6E2F0" BorderThickness="1" CornerRadius="5" Margin="0,0,8,0" Padding="8,5">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="② 邊界修補" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#284A6C" Margin="0,0,8,0"/>
                                        <Button x:Name="btnAutoJoinWalls" Content="自動接合牆面" Width="104" Style="{StaticResource CompactToolbarButton}"
                                                ToolTip="先修復選取房間周邊結構牆端點，再接合已產生的裝修牆面。"/>
                                        <Button x:Name="btnAlignToColumns" Content="對齊結構柱邊" Width="104" Style="{StaticResource CompactToolbarButton}"
                                                ToolTip="將接近結構柱的結構牆端點對齊到柱側面，用於修補房間邊界缺口。"/>
                                        <Button x:Name="btnToggleWallJoins" Content="端點接合切換" Width="104" Style="{StaticResource CompactToolbarButton}" Margin="0,0,2,0"
                                                ToolTip="切換選取房間內裝修牆兩端是否允許 Revit 自動端點接合。"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#F8FBFF" BorderBrush="#D6E2F0" BorderThickness="1" CornerRadius="5" Margin="0,0,8,0" Padding="8,5">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="③ 批次選取" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#284A6C" Margin="0,0,8,0"/>
                                        <Button x:Name="btnSelectAll" Content="全選" Width="52" Style="{StaticResource CompactToolbarButton}" Margin="0,0,4,0"/>
                                        <Button x:Name="btnDeselectAll" Content="取消全選" Width="74" Style="{StaticResource CompactToolbarButton}" Margin="0,0,4,0"/>
                                        <Button x:Name="btnInvertSelect" Content="反選" Width="52" Style="{StaticResource CompactToolbarButton}" Margin="0,0,6,0"/>
                                        <Button x:Name="btnClearArParams" Content="清理AR參數" Width="92" Style="{StaticResource CompactToolbarButton}" Margin="0,0,2,0"
                                                ToolTip="手動清除選取元素或非AR裝修結構元素上的 AR 裝修參數值。"/>
                                    </StackPanel>
                                </Border>
                            </WrapPanel>

                            <Button x:Name="btnApplyReplaceToModel" Grid.Row="1" Grid.Column="1" Content="④ 套用並更新粉刷面" Width="172" Height="34"
                                    Margin="8,0,0,0" VerticalAlignment="Top"
                                    Background="{StaticResource PrimaryBlue}" Foreground="White" FontWeight="SemiBold" BorderBrush="#02172A"/>
                        </Grid>
                    </Border>

                    <!-- ─── 篩選列 ─── -->
                    <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="12,8" Margin="0,0,0,6">
                        <DockPanel>
                            <Button x:Name="btnClearFilters" Content="清除" Width="56" Height="30" DockPanel.Dock="Right" Margin="6,0,0,0"/>
                            <TextBlock x:Name="txtFilterCount" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="#8A9BAE" FontSize="12" Margin="0,0,6,0"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="搜尋：" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,0"/>
                                <TextBox x:Name="txtSearchRooms" Width="200" Height="30" Margin="0,0,12,0" VerticalContentAlignment="Center" Padding="6,0"/>
                                <TextBlock Text="樓層：" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="cmbLevelFilter" Width="160" Height="30" Margin="0,0,12,0"/>
                                <TextBlock Text="狀態：" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="cmbStatusFilter" Width="160" Height="30" Margin="0,0,12,0"/>
                                <CheckBox x:Name="chkOnlySelected" Content="只看已選取" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- ─── DataGrid ─── -->
                    <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="4">
                        <DataGrid x:Name="dgRooms" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False"
                                  HeadersVisibility="Column" SelectionMode="Extended" SelectionUnit="FullRow"
                                  SelectionChanged="DgRooms_SelectionChanged"
                                  MouseDoubleClick="DgRooms_MouseDoubleClick"
                                  FrozenColumnCount="4" EnableRowVirtualization="True" EnableColumnVirtualization="True"
                                  RowHeaderWidth="0" RowHeight="30" ColumnHeaderHeight="34"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEF0F2">
                            <DataGrid.Columns>
                                <!-- 全選 checkbox 欄 -->
                                <DataGridTemplateColumn Width="48" CanUserResize="False" CanUserSort="False" CanUserReorder="False">
                                    <DataGridTemplateColumn.HeaderTemplate>
                                        <DataTemplate>
                                            <CheckBox Click="ChkHeaderAll_Click" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      ToolTip="全選 / 取消全選目前篩選結果"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.HeaderTemplate>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Click="ChkRowSelect_Click"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="房間名稱" Binding="{Binding Name}" Width="180" IsReadOnly="True"/>
                                <DataGridTextColumn Header="房間編號" Binding="{Binding Number}" Width="90" IsReadOnly="True"/>
                                <DataGridTextColumn Header="樓層" Binding="{Binding Level}" Width="90" IsReadOnly="True"/>

                                <DataGridTemplateColumn Header="牆面塗層" Width="180">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.WallTypeOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      Tag="WallTypeId"
                                                      SelectionChanged="RoomRowCombo_SelectionChanged"
                                                      Height="24" DisplayMemberPath="Name" SelectedValuePath="Id"
                                                      SelectedValue="{Binding WallTypeId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="牆高 (mm)" Binding="{Binding WallHeightMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="110"/>

                                <DataGridTemplateColumn Header="樓板塗層" Width="180">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.FloorTypeOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      Tag="FloorTypeId"
                                                      SelectionChanged="RoomRowCombo_SelectionChanged"
                                                      Height="24" DisplayMemberPath="Name" SelectedValuePath="Id"
                                                      SelectedValue="{Binding FloorTypeId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="天花塗層" Width="180">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.CeilingTypeOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      Tag="CeilingTypeId"
                                                      SelectionChanged="RoomRowCombo_SelectionChanged"
                                                      Height="24" DisplayMemberPath="Name" SelectedValuePath="Id"
                                                      SelectedValue="{Binding CeilingTypeId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="天花高度 (mm)" Binding="{Binding CeilingHeightMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="130"/>

                                <DataGridTemplateColumn Header="踢腳板類型" Width="180">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.SkirtingTypeOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      Tag="SkirtingTypeId"
                                                      SelectionChanged="RoomRowCombo_SelectionChanged"
                                                      Height="24" DisplayMemberPath="Name" SelectedValuePath="Id"
                                                      SelectedValue="{Binding SkirtingTypeId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="設定狀態" Binding="{Binding Status}" Width="140" IsReadOnly="True"/>
                                <DataGridTemplateColumn Header="生成狀態" Width="90" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ModelSyncStatus}"
                                                       Foreground="{Binding ModelSyncStatusBrush}"
                                                       VerticalAlignment="Center"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- ─── 批次套用面板 ─── -->
                    <Border Grid.Row="3" Background="#EDF4FE" BorderBrush="#C8D9F2" BorderThickness="1" CornerRadius="6"
                            Padding="12,8" Margin="0,6,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- 標題 + 已選取計數 -->
                            <StackPanel Grid.Column="0" Grid.RowSpan="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="批次套用" FontWeight="Bold" FontSize="13" Foreground="#03233D"/>
                                <TextBlock x:Name="txtPickedCount" Foreground="#5D6B7A" FontSize="11" Margin="0,3,0,0"/>
                            </StackPanel>

                            <!-- 第一排：類型下拉 -->
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="牆面：" VerticalAlignment="Center" Width="36" FontSize="12"/>
                                <ComboBox x:Name="cmbBatchWall" Width="138" Height="28" Margin="0,0,10,0" DisplayMemberPath="Name" SelectedValuePath="Id"/>
                                <TextBlock Text="樓板：" VerticalAlignment="Center" Width="36" FontSize="12"/>
                                <ComboBox x:Name="cmbBatchFloor" Width="138" Height="28" Margin="0,0,10,0" DisplayMemberPath="Name" SelectedValuePath="Id"/>
                                <TextBlock Text="天花：" VerticalAlignment="Center" Width="36" FontSize="12"/>
                                <ComboBox x:Name="cmbBatchCeiling" Width="138" Height="28" Margin="0,0,10,0" DisplayMemberPath="Name" SelectedValuePath="Id"/>
                                <TextBlock Text="踢腳板：" VerticalAlignment="Center" Width="50" FontSize="12"/>
                                <ComboBox x:Name="cmbBatchSkirting" Width="138" Height="28" DisplayMemberPath="Name" SelectedValuePath="Id"/>
                            </StackPanel>

                            <!-- 第二排：高度 -->
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="牆高 (mm)：" VerticalAlignment="Center" FontSize="12" Margin="0,0,4,0"/>
                                <TextBox x:Name="txtBatchWallHeight" Width="70" Height="28" VerticalContentAlignment="Center" Padding="6,0" Margin="0,0,20,0"/>
                                <TextBlock Text="天花高 (mm)：" VerticalAlignment="Center" FontSize="12" Margin="0,0,4,0"/>
                                <TextBox x:Name="txtBatchCeilingHeight" Width="70" Height="28" VerticalContentAlignment="Center" Padding="6,0"/>
                            </StackPanel>

                            <!-- 套用按鈕 -->
                            <Button x:Name="btnBatchApply" Grid.Column="2" Grid.RowSpan="2"
                                    Content="套用到選取列" Width="110" Height="52"
                                    Background="{StaticResource AccentBlue}" Foreground="White" FontWeight="SemiBold" Margin="12,0,0,0"/>
                        </Grid>
                    </Border>

                    <!-- ─── 底部執行列 ─── -->
                    <Border Grid.Row="4" Style="{StaticResource CardBorderStyle}"
                            Padding="10" Margin="0,6,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" ItemHeight="30">
                                <CheckBox x:Name="chkSkipOpeningsForWalls" Content="避開門窗開口" IsChecked="True" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <CheckBox x:Name="chkSetValuesGeom" Content="設定幾何元素參數" IsChecked="True" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <CheckBox x:Name="chkSetValuesRooms" Content="設定房間參數" IsChecked="True" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <CheckBox x:Name="chkPreserveManualAdjustments" Content="保留手動調整（混合房間不覆蓋）" IsChecked="True" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            </WrapPanel>

                            <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="btnUpdateValues" Content="僅更新參數" Width="106" Height="34" Margin="0,0,8,0"/>
                                <Button x:Name="btnGenerate" Content="自動產出裝修面" Width="154" Height="34"
                                        Background="{StaticResource PrimaryBlue}" Foreground="White" FontWeight="SemiBold"/>
                            </WrapPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock x:Name="txtStatus" Text="就緒" Foreground="#637181"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>

