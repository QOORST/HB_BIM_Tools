<Window x:Class="YD_RevitTools.LicenseManager.Commands.Family.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="&#x65CF;&#x7FA4;&#x53C3;&#x6578;&#x6279;&#x6B21;&#x5DE5;&#x5177;" Height="760" Width="760"
        MinHeight="620" MinWidth="680"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Topmost="True"
        ShowInTaskbar="True">
    <DockPanel Margin="16">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Name="TypeLabel" Text="&#x7576;&#x524D;&#x985E;&#x578B;:" FontSize="17" FontWeight="Bold"/>
                <TextBlock Text="&#x9577;&#x5EA6;&#x6578;&#x503C;&#x8ACB;&#x8F38;&#x5165; mm&#x3002;&#x5207;&#x63DB;&#x5206;&#x9801;&#x53EF;&#x5206;&#x5225;&#x8655;&#x7406;&#x76EE;&#x524D;&#x985E;&#x578B;&#x3001;&#x6279;&#x6B21;&#x547D;&#x540D;&#x8207;&#x6279;&#x6B21;&#x53C3;&#x6578;&#x3002;"
                           FontSize="11" Foreground="#536471" Margin="0,5,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12,0,0,0">
                <Button Name="RefreshButton" Content="&#x5237;&#x65B0;" Click="Refresh_Click" Padding="12,5" Margin="0,0,8,0"/>
                <Button Click="OpenSettings_Click" Content="&#x8A2D;&#x5B9A;" Padding="12,5"/>
            </StackPanel>
        </Grid>

        <TabControl>
            <TabItem Header="&#x76EE;&#x524D;&#x985E;&#x578B;&#x53C3;&#x6578;">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="&#x53EA;&#x8ABF;&#x6574;&#x76EE;&#x524D;&#x9078;&#x53D6;&#x7684;&#x65CF;&#x985E;&#x578B;&#x3002;"
                               Foreground="#536471" Margin="0,0,0,8" TextWrapping="Wrap"/>
                    <Border Grid.Row="1" BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="3" Padding="10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Name="MainStack" />
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="&#x6279;&#x6B21;&#x985E;&#x578B;&#x547D;&#x540D;">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="&#x6279;&#x6B21;&#x8ABF;&#x6574;&#x6240;&#x6709;&#x65CF;&#x985E;&#x578B;&#x540D;&#x7A31;&#xFF0C;&#x53EF;&#x5148;&#x505A;&#x5C0B;&#x627E;&#x53D6;&#x4EE3;&#x3001;&#x518D;&#x52A0;&#x524D;&#x5F8C;&#x7DB4;&#x3002;"
                               Foreground="#536471" Margin="0,0,0,10" TextWrapping="Wrap"/>
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="&#x5C0B;&#x627E;" VerticalAlignment="Center" Margin="0,0,8,6"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Name="TypeFindBox" MinWidth="160" Margin="0,0,16,6" TextChanged="TypeAffix_TextChanged"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="&#x53D6;&#x4EE3;&#x70BA;" VerticalAlignment="Center" Margin="0,0,8,6"/>
                        <TextBox Grid.Row="0" Grid.Column="3" Name="TypeReplaceBox" MinWidth="160" Margin="0,0,0,6" TextChanged="TypeAffix_TextChanged"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="&#x524D;&#x7DB4;" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Name="TypePrefixBox" MinWidth="160" Margin="0,0,16,0" TextChanged="TypeAffix_TextChanged"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="&#x5F8C;&#x7DB4;" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Grid.Row="1" Grid.Column="3" Name="TypeSuffixBox" MinWidth="160" TextChanged="TypeAffix_TextChanged"/>
                    </Grid>
                    <ListView Grid.Row="2" Name="TypeRenamePreviewList" MinHeight="260">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="&#x5957;&#x7528;" Width="55">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox HorizontalAlignment="Center" IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanApply}" Checked="TypeRenameSelection_Changed" Unchecked="TypeRenameSelection_Changed"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="&#x76EE;&#x524D;&#x540D;&#x7A31;" DisplayMemberBinding="{Binding CurrentName}" Width="230"/>
                                <GridViewColumn Header="&#x65B0;&#x540D;&#x7A31;" DisplayMemberBinding="{Binding NewName}" Width="230"/>
                                <GridViewColumn Header="&#x72C0;&#x614B;" DisplayMemberBinding="{Binding Status}" Width="110"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <Grid Grid.Row="3" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Name="TypeRenameSummary" Grid.Column="0" Foreground="#536471" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="12,0,0,0">
                            <Button Name="ExportTypeRenameButton" Content="&#x532F;&#x51FA; CSV" Click="ExportTypeRenameCsv_Click" Padding="12,5" Margin="0,0,8,0"/>
                            <Button Name="PreviewTypeRenameButton" Content="&#x9810;&#x89BD;" Click="PreviewTypeRename_Click" Padding="12,5" Margin="0,0,8,0"/>
                            <Button Name="ApplyTypeRenameButton" Content="&#x5957;&#x7528;" Click="ApplyTypeRename_Click" Padding="12,5"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="&#x6279;&#x6B21;&#x53C3;&#x6578;&#x8ABF;&#x6574;">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="&#x6279;&#x6B21;&#x5957;&#x7528;&#x81F3;&#x52FE;&#x9078;&#x7684;&#x65CF;&#x985E;&#x578B;&#x3002;&#x53EA;&#x986F;&#x793A;&#x53EF;&#x5BEB;&#x5165;&#x7684;&#x985E;&#x578B;&#x53C3;&#x6578;&#x3002;"
                               Foreground="#536471" Margin="0,0,0,10" TextWrapping="Wrap"/>
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#x53C3;&#x6578;" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox Grid.Column="1" Name="BatchParameterCombo" DisplayMemberPath="Name" SelectionChanged="BatchParameter_Changed"/>
                        <TextBlock Grid.Column="2" Text="&#x65B0;&#x503C;" VerticalAlignment="Center" Margin="16,0,8,0"/>
                        <TextBox Grid.Column="3" Name="BatchParameterValueBox" MinWidth="160" TextChanged="BatchParameter_Changed"/>
                        <TextBlock Grid.Column="4" Name="BatchParameterUnitText" Text="" Foreground="#536471" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>
                    <ListView Grid.Row="2" Name="BatchParameterPreviewList" MinHeight="260">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="&#x5957;&#x7528;" Width="55">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox HorizontalAlignment="Center" IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanApply}" Checked="BatchParameterSelection_Changed" Unchecked="BatchParameterSelection_Changed"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="&#x985E;&#x578B;" DisplayMemberBinding="{Binding TypeName}" Width="210"/>
                                <GridViewColumn Header="&#x76EE;&#x524D;&#x503C;" DisplayMemberBinding="{Binding CurrentValue}" Width="125"/>
                                <GridViewColumn Header="&#x65B0;&#x503C;" DisplayMemberBinding="{Binding NewValue}" Width="125"/>
                                <GridViewColumn Header="&#x72C0;&#x614B;" DisplayMemberBinding="{Binding Status}" Width="120"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <Grid Grid.Row="3" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Name="BatchParameterSummary" Grid.Column="0" Foreground="#536471" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="12,0,0,0">
                            <Button Name="ExportBatchParameterButton" Content="&#x532F;&#x51FA; CSV" Click="ExportBatchParameterCsv_Click" Padding="12,5" Margin="0,0,8,0"/>
                            <Button Name="PreviewBatchParameterButton" Content="&#x9810;&#x89BD;" Click="PreviewBatchParameter_Click" Padding="12,5" Margin="0,0,8,0"/>
                            <Button Name="ApplyBatchParameterButton" Content="&#x5957;&#x7528;" Click="ApplyBatchParameter_Click" Padding="12,5"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>