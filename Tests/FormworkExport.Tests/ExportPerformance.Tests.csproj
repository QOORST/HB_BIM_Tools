<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <FormworkSourceDir Condition="'$(FormworkSourceDir)' == ''">../../Commands/AR/Formwork</FormworkSourceDir>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="EPPlus" Version="7.5.2" />
    <Compile Include="$(FormworkSourceDir)/CmdExportCsv.cs" Link="CmdExportCsv.cs" />
    <Compile Include="$(FormworkSourceDir)/ExportTemplateRules.cs" Link="ExportTemplateRules.cs" />
    <Compile Include="$(FormworkSourceDir)/ExportOutputFile.cs" Link="ExportOutputFile.cs" />
  </ItemGroup>
</Project>
