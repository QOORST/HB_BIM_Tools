<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <SourceRoot Condition="'$(SourceRoot)' == ''">$(MSBuildThisFileDirectory)../../Commands/AutoJoin</SourceRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(SourceRoot)/TypeJoinRule.cs" Link="Core/TypeJoinRule.cs" />
    <Compile Include="$(SourceRoot)/TypeJoinResolver.cs" Link="Core/TypeJoinResolver.cs" />
    <Compile Include="$(SourceRoot)/AutoJoinSettings.cs" Link="Core/AutoJoinSettings.cs" />
    <Compile Include="$(SourceRoot)/SettingsSerializer.cs" Link="Core/SettingsSerializer.cs" />
  </ItemGroup>
</Project>
