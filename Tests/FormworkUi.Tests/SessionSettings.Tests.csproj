<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <FormworkSourcePath Condition="'$(FormworkSourcePath)' == ''">$(MSBuildThisFileDirectory)..\..\Commands\AR\Formwork\CmdMain.cs</FormworkSourcePath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="FormworkUi.generated.cs" />
    <Compile Include="FormworkUi.generated.cs" />
  </ItemGroup>
  <Target Name="GenerateFormworkUiSource" BeforeTargets="BeforeBuild">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)Generate-Source.ps1&quot; -SourcePath &quot;$(FormworkSourcePath)&quot;" />
  </Target>
</Project>
